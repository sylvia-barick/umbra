# Copy to .env. Run `npm run fund` to generate + friendbot-fund a fresh
# testnet keypair for KEEPER_SECRET_KEY automatically, or paste your own.
NETWORK=testnet
KEEPER_SECRET_KEY=

# Point these at ../deployed_addresses.testnet.env's values (or your own deployment).
ORACLE_ADAPTER_ID=
VAULT_ACCOUNTING_ID=
AMM_POOL_ID=
OPTIONS_FACTORY_ID=
SETTLEMENT_KEEPER_ID=
TOKEN_ADDR=
REFLECTOR_ADDR=
UNDERLYING_SYMBOL=XLM

# Seconds between poll cycles (nudge volatility + check settleable series).
POLL_INTERVAL_SECS=60
# Highest series id to probe for when enumerating the catalog each cycle.
MAX_SERIES_PROBE=200
